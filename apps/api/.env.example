# Central DB (Phase 1)
TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
TURSO_AUTH_TOKEN=your-jwt-token

# Turso Platform API (Phase 2.2) - tenant DB を programmatic に作成するため
# - https://app.turso.tech/<org>/settings → API Tokens (Full Access、default group に pin 推奨)
TURSO_PLATFORM_API_TOKEN=
TURSO_ORG_SLUG=

# better-auth
# generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# Google OAuth (ADR-004)
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# Authorized redirect URI (dev): http://localhost:5173/api/auth/callback/google
#   ※ BETTER_AUTH_URL と同じ host にすること (cookie scope の都合)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
