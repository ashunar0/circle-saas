TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
TURSO_AUTH_TOKEN=your-jwt-token

# better-auth
# generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# Google OAuth (ADR-004)
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# Authorized redirect URI (dev): http://localhost:5173/api/auth/callback/google
#   ※ BETTER_AUTH_URL と同じ host にすること (cookie scope の都合)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
